{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "reconcileNamespace": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configMapName", "configMapKey", "tlsSecrets", "publicCAConfigMaps"],
      "properties": {
        "configMapName": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
        "configMapKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$", "not": {"pattern": "^\\.\\.|^\\.$"}},
        "tlsSecrets": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"}},
        "publicCAConfigMaps": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"}}
      }
    },
    "archiveLimits": {
      "type": "object", "additionalProperties": false, "required": ["maxBytes", "maxEntries"],
      "properties": {
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "maxEntries": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "webhook": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "policyCapture": {
      "type": "object",
      "properties": {
        "opaListeners": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "port"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 15, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$", "not": {"enum": ["metrics", "probes", "webhook"]}},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }
        }
      }
    }
  }
}
